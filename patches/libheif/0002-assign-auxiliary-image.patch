+heif_error heif_context_assign_auxiliary_image(heif_context* ctx,
+                                               const heif_image_handle* master_image,
+                                               const heif_image_handle* auxiliary_image,
+                                               const char* auxiliary_type)
+{
+  if (!ctx || !master_image || !auxiliary_image || !auxiliary_type) {
+    return heif_error_null_pointer_argument;
+  }
+
+  Error error = ctx->context->assign_auxiliary_image(master_image->image,
+                                                     auxiliary_image->image,
+                                                     auxiliary_type);
+  return error.error_struct(ctx->context.get());
+}

 }
 
 
+Error HeifContext::assign_auxiliary_image(const std::shared_ptr<ImageItem>& master_image,
+                                          const std::shared_ptr<ImageItem>& auxiliary_image,
+                                          const std::string& auxiliary_type)
+{
+  if (!master_image || !auxiliary_image) {
+    return Error(heif_error_Usage_error, heif_suberror_Invalid_parameter_value);
+  }
+
+  m_heif_file->add_iref_reference(auxiliary_image->get_id(), fourcc("auxl"), {master_image->get_id()});
+  if (Error err = m_heif_file->set_auxC_property(auxiliary_image->get_id(), auxiliary_type)) {
+    return err;
+  }
+  m_heif_file->get_infe_box(auxiliary_image->get_id())->set_hidden_item(true);
+
+  auxiliary_image->set_is_aux_image(auxiliary_type);
+  master_image->add_aux_image(auxiliary_image);
+  remove_top_level_image(auxiliary_image);
+
+  return Error::Ok;
+}
